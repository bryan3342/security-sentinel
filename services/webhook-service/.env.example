
# Server
PORT=3000
NODE_ENV=development

# GitHub
GITHUB_WEBHOOK_SECRET=secret

# Redis (shared with analysis-worker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Rate limiting on POST /webhook
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Replay protection — TTL for X-GitHub-Delivery dedup keys (24h default,
# matching GitHub's redelivery window)
REPLAY_TTL_SECONDS=86400

# Logging
LOG_LEVEL=info