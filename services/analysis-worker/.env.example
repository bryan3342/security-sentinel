
# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Worker concurrency — number of jobs processed in parallel
WORKER_CONCURRENCY=2

# Redis (must match webhook-service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=security_sentinel
PG_USER=sentinel
PG_PASSWORD=password
PG_POOL_MAX=10

# Repo checkout
# Optional: GitHub token for private repo access (omit for public-only)
GITHUB_TOKEN=
# Root directory for job-scoped working dirs; defaults to <os.tmpdir>/sentinel
WORKDIR_ROOT=

# Semgrep
# `auto` uses Semgrep's default rule selection; alternatives: p/security-audit, p/owasp-top-ten
SEMGREP_CONFIG=auto

# Claude Agent SDK (Anthropic)
ANTHROPIC_API_KEY=
# Model tiers — cheap triager + validator, capable mechanic + researcher
CLAUDE_MODEL_TRIAGER=claude-haiku-4-5-20251001
CLAUDE_MODEL_RESEARCHER=claude-sonnet-4-6
CLAUDE_MODEL_MECHANIC=claude-sonnet-4-6
CLAUDE_MODEL_VALIDATOR=claude-haiku-4-5-20251001

# Hard per-job token budget; job is failed with 'budget exceeded' if crossed
TOKEN_BUDGET_INPUT=200000
TOKEN_BUDGET_OUTPUT=50000

# Mechanic ↔ Validator reflection loop cap
AGENT_MAX_ITERATIONS=3

# Skip the agentic loop entirely (handler stops after findings persist).
# Useful for local dev without an Anthropic API key.
SKIP_AGENT_LOOP=false

# Sandbox (M3) — runs patched code via Docker with no network, dropped caps, non-root
SANDBOX_IMAGE=sentinel-sandbox:latest
SANDBOX_MEMORY_BYTES=1073741824
SANDBOX_CPUS=1
SANDBOX_TIMEOUT_MS=120000

# GitHub PR creation (M5) — prefer App auth in prod; PAT works for personal repos.
# Either set GITHUB_APP_* (App, recommended) or GITHUB_TOKEN (PAT).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# GITHUB_TOKEN is also used by services/analysis-worker for private-repo checkouts.
PR_BASE_BRANCH=main
PR_REVIEWERS=
SKIP_PR_CREATION=false
